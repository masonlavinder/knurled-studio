{
  "name": "knurled",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-catalog.ts",
    "typecheck": "tsc -b",
